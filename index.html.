    <p style="font-size:12px;margin-top:15px">
      Catatan: rekening di atas hanyalah data contoh. Ganti sebelum undangan dibagikan.
    </p>
  </div>
</section>

<!-- RSVP -->
<section>
  <div class="container reveal">
    <p class="eyebrow">KINDLY RSVP</p>
    <h2>Konfirmasi Kehadiran</h2>
    <p>Mohon isi konfirmasi dan sampaikan doa terbaik Anda.</p>

    <div class="card">
      <form id="rsvpForm">
        <input id="nama" placeholder="Nama lengkap" required>
        <select id="status" required>
          <option value="">Konfirmasi kehadiran</option>
          <option value="Hadir">Hadir</option>
          <option value="Tidak hadir">Tidak dapat hadir</option>
        </select>
        <input id="jumlah" type="number" min="1" max="10"
               value="1" required placeholder="Jumlah tamu">
        <textarea id="pesan" rows="4" placeholder="Ucapan dan doa..."></textarea>
        <button type="submit">Kirim via WhatsApp 💌</button>
      </form>
    </div>
  </div>
</section>

<!-- BUKU TAMU -->
<section>
  <div class="container reveal">
    <p class="eyebrow">WISHES FOR THE COUPLE</p>
    <h2>Ucapan &amp; Doa</h2>
    <p>Tinggalkan pesan manis untuk kedua mempelai.</p>

    <div class="card">
      <form id="guestForm">
        <input id="guestName" placeholder="Nama kamu" required>
        <textarea id="guestMessage" rows="3"
                  placeholder="Tulis ucapan dan doa..." required></textarea>
        <button type="submit">Kirim Ucapan ❤️</button>
      </form>
      <div id="guestList"></div>
      <p style="font-size:12px;margin-top:15px">
        Ucapan di halaman ini hanya tersimpan di browser perangkat ini.
      </p>
    </div>
  </div>
</section>

<!-- PENUTUP -->
<footer>
  <div class="flower" style="color:white">❀</div>
  <p>Merupakan suatu kehormatan dan kebahagiaan bagi kami</p>
  <p>atas kehadiran serta doa restu Anda.</p>
  <h1 class="script" style="margin:25px 0">Andi &amp; Putri</h1>
  <p>Terima kasih ❤️</p>
  <p style="font-size:11px;margin-top:25px">Made with love ♡</p>
</footer>

</main>

<script>
// ======================================
// PENGATURAN UNDANGAN - EDIT DI SINI
// ======================================

// Tanggal acara dalam zona waktu WIB (UTC+7)
const tanggalNikah = new Date("2026-12-20T08:00:00+07:00").getTime();

// Nomor WhatsApp tuan rumah.
// Gunakan kode negara tanpa tanda +.
// Contoh: 6281234567890
const nomorWhatsApp = "6281234567890";

// ======================================
// BUKA UNDANGAN
// ======================================
function bukaUndangan() {
  document.getElementById("cover").classList.add("closed");
  document.getElementById("main").style.display = "block";
  document.body.style.overflow = "auto";
  window.scrollTo(0, 0);
}

// ======================================
// COUNTDOWN
// ======================================
function updateCountdown() {
  const selisih = tanggalNikah - Date.now();
  const msg = document.getElementById("countdownMessage");

  if (selisih <= 0) {
    ["days","hours","minutes","seconds"].forEach(id => {
      document.getElementById(id).textContent = "0";
    });
    msg.textContent = "Hari bahagia telah tiba! ❤️";
    return;
  }

  document.getElementById("days").textContent =
    Math.floor(selisih / 86400000);
  document.getElementById("hours").textContent =
    Math.floor(selisih / 3600000) % 24;
  document.getElementById("minutes").textContent =
    Math.floor(selisih / 60000) % 60;
  document.getElementById("seconds").textContent =
    Math.floor(selisih / 1000) % 60;

  msg.textContent = "Kami menantikan kehadiran Anda ❤️";
}

updateCountdown();
setInterval(updateCountdown, 1000);

// ======================================
// SALIN NOMOR REKENING
// ======================================
async function salin(id, tombol) {
  const teks = document.getElementById(id).textContent.trim();

  try {
    await navigator.clipboard.writeText(teks);
  } catch (error) {
    const area = document.createElement("textarea");
    area.value = teks;
    area.style.position = "fixed";
    area.style.opacity = "0";
    document.body.appendChild(area);
    area.select();
    const berhasil = document.execCommand("copy");
    area.remove();

    if (!berhasil) {
      alert("Gagal menyalin. Silakan salin manual: " + teks);
      return;
    }
  }

  const teksAsli = tombol.textContent;
  tombol.textContent = "✓ Berhasil Disalin!";
  setTimeout(() => tombol.textContent = teksAsli, 2000);
}

// ======================================
// RSVP VIA WHATSAPP
// ======================================
document.getElementById("rsvpForm").addEventListener("submit", function(e) {
  e.preventDefault();

  const nama = document.getElementById("nama").value.trim();
  const status = document.getElementById("status").value;
  const jumlah = document.getElementById("jumlah").value;
  const pesan = document.getElementById("pesan").value.trim();

  const teks =
    `Halo, saya ingin mengonfirmasi undangan pernikahan Andi & Putri.\n\n` +
    `Nama: ${nama}\n` +
    `Kehadiran: ${status}\n` +
    `Jumlah tamu: ${jumlah}\n` +
    `Ucapan: ${pesan || "-"}`;

  window.open(
    "https://wa.me/" + nomorWhatsApp + "?text=" +
    encodeURIComponent(teks),
    "_blank",
    "noopener"
  );
});

// ======================================
// UCAPAN TAMU - PENYIMPANAN LOKAL
// ======================================
const guestForm = document.getElementById("guestForm");
const guestList = document.getElementById("guestList");

function tampilkanUcapan(nama, pesan) {
  const kartu = document.createElement("div");
  kartu.className = "guest";

  const namaEl = document.createElement("strong");
  namaEl.textContent = nama;

  const pesanEl = document.createElement("p");
  pesanEl.textContent = pesan;

  kartu.append(namaEl, pesanEl);
  guestList.prepend(kartu);
}

guestForm.addEventListener("submit", function(e) {
  e.preventDefault();

  const nama = document.getElementById("guestName").value.trim();
  const pesan = document.getElementById("guestMessage").value.trim();

  if (!nama || !pesan) return;

  tampilkanUcapan(nama, pesan);
  guestForm.reset();
});

// ======================================
// ANIMASI SAAT BAGIAN MUNCUL
// ======================================
const observer = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add("visible");
      observer.unobserve(entry.target);
    }
  });
}, { threshold: 0.12 });

document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
</script>

</body>
</html>
