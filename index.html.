  </div>
</section>

<!-- MEMPELAI -->
<section id="mempelai">
  <div class="container reveal">
    <p class="eyebrow">THE BRIDE &amp; THE GROOM</p>
    <h2>Mempelai</h2>

    <div class="card">
      <img class="portrait"
        src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=600&q=80"
        alt="Foto ilustrasi mempelai wanita">
      <div class="names">Putri</div>
      <p>Putri dari Bapak [Nama Ayah] dan Ibu [Nama Ibu]</p>

      <div class="flower">&amp;</div>

      <img class="portrait"
        src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=600&q=80"
        alt="Foto ilustrasi mempelai pria">
      <div class="names">Andi</div>
      <p>Putra dari Bapak [Nama Ayah] dan Ibu [Nama Ibu]</p>
    </div>
  </div>
</section>

<!-- COUNTDOWN -->
<section>
  <div class="container reveal">
    <p class="eyebrow">SAVE THE DATE</p>
    <h2>Menuju Hari Bahagia</h2>
    <p>Minggu, 20 Desember 2026</p>

    <div class="countdown" id="countdown">
      <div class="time"><strong id="days">0</strong>Hari</div>
      <div class="time"><strong id="hours">0</strong>Jam</div>
      <div class="time"><strong id="minutes">0</strong>Menit</div>
      <div class="time"><strong id="seconds">0</strong>Detik</div>
    </div>
    <p id="countdownMessage"></p>

    <a class="btn" target="_blank" rel="noopener"
       href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Pernikahan+Andi+dan+Putri&dates=20261220T010000Z/20261220T080000Z">
       Tambahkan ke Google Calendar
    </a>
  </div>
</section>

<!-- GALERI -->
<section>
  <div class="container reveal">
    <p class="eyebrow">OUR MEMORIES</p>
    <h2>Galeri Cinta</h2>
    <p>Sepenggal kisah menuju selamanya.</p>

    <div class="gallery">
      <img loading="lazy"
        src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=900&q=80"
        alt="Dekorasi pernikahan">
      <img loading="lazy"
        src="https://images.unsplash.com/photo-1523438885200-e635ba2c371e?auto=format&fit=crop&w=600&q=80"
        alt="Bunga pernikahan">
      <img loading="lazy"
        src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=600&q=80"
        alt="Momen pernikahan">
    </div>
    <p style="font-size:12px">Foto di atas hanya contoh. Ganti dengan foto kalian sendiri.</p>
  </div>
</section>

<!-- ACARA -->
<section>
  <div class="container reveal">
    <p class="eyebrow">JOIN OUR CELEBRATION</p>
    <h2>Waktu &amp; Tempat</h2>

    <div class="card">
      <div class="flower">❀</div>
      <h3>Akad Nikah</h3>
      <p class="date">Minggu, 20 Desember 2026</p>
      <p>Pukul 08.00 WIB – selesai</p>
      <div class="flower">❦</div>
      <h3>Resepsi</h3>
      <p class="date">Minggu, 20 Desember 2026</p>
      <p>Pukul 11.00–14.00 WIB</p>
      <hr style="border:0;border-top:1px solid #eadbd5;margin:25px 0">
      <h3>Gedung Pernikahan</h3>
      <p>[Nama Gedung]</p>
      <p>[Alamat lengkap acara]</p>
      <a class="btn" target="_blank" rel="noopener"
