      <button onclick="salin('rekening1',this)">📋 Salin Nomor Rekening</button>
    </div>

    <div class="bank">
      <div class="bank-logo">BANK BRI</div>
      <p>Nomor Rekening</p>
      <div class="account" id="rekening2">0987654321</div>
      <p>a.n. Putri</p>
      <button onclick="salin('rekening2',this)">📋 Salin Nomor Rekening</button>
